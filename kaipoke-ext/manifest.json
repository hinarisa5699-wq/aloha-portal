{
  "manifest_version": 3,
  "name": "アロハ業務ポータル カイポケ更新",
  "version": "1.0.0",
  "description": "アロハ業務ポータルの「カイポケから更新」ボタンで、カイポケの利用者情報・被保険者証情報・訪問介護シフト・訪問看護スケジュールを読み取ってポータルに渡します",
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["https://r.kaipoke.biz/*"],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "externally_connectable": { "matches": ["https://hinarisa5699-wq.github.io/*"] },
  "content_scripts": [
    { "matches": ["https://hinarisa5699-wq.github.io/aloha-portal/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ]
}
